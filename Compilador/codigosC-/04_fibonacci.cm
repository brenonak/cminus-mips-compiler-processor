/* Fibonacci iterativo
   Testa: while, troca de variaveis, sem recursao */

int fibonacci(int n)
{
    int a; int b; int temp; int i;
    a = 0;
    b = 1;
    i = 0;
    while (i < n)
    {
        temp = b;
        b = a + b;
        a = temp;
        i = i + 1;
    }
    return a;
}

void main(void)
{
    int n;
    n = input();
    output(fibonacci(n));
}
